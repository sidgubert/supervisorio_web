# Banco (TimescaleDB via Docker)
DB_HOST=localhost
# 5433 evita conflito com PostgreSQL local na 5432 (Windows)
DB_PORT=5433
DB_USER=scada
DB_PASSWORD=scada
DB_NAME=scada
# Aplica as migrations pendentes na subida da API
DB_MIGRATIONS_RUN=true

# API
PORT=3000

# Login (desligado = acesso livre, bom para laboratório). Ligado, exige senha e
# um segredo aleatório de 32+ caracteres para assinar os tokens (24 h). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENABLED=false
AUTH_USER=operador
AUTH_PASSWORD=
AUTH_SECRET=

# Ingestão (comum a todas as fontes)
INGEST_FLUSH_MS=2000
# Teto do buffer em memoria se o banco cair (descarta as amostras mais antigas)
INGEST_BUFFER_MAX=100000

# Tempo real (WebSocket e SSE): agrupa o envio por tag a cada LIVE_FLUSH_MS (0 = imediato)
LIVE_FLUSH_MS=200
# Teto de amostras por tag em cada envio (mantém as mais recentes)
LIVE_MAX_SAMPLES_PER_TAG=100

# Alarmes: banda morta padrão (% do limite) para a tag sem deadband própria
ALARM_HYSTERESIS_PCT=2

# Retenção: apaga do banco as medições mais antigas que RETENTION_DAYS (mín. 8).
# Desligada = guarda tudo (e remove a política, se houver).
RETENTION_ENABLED=false
RETENTION_DAYS=90

# Simulador (Fase 1)
SIM_ENABLED=true
SIM_INTERVAL_MS=1000

# Fonte MQTT (broker do docker compose)
MQTT_ENABLED=true
MQTT_URL=mqtt://localhost:1883
# Vazios = sem autenticacao
MQTT_USERNAME=
MQTT_PASSWORD=

# Fonte Modbus TCP. Para testar sem CLP: npm run sim:modbus (porta 5020)
MODBUS_ENABLED=false
MODBUS_HOST=localhost
MODBUS_PORT=5020
MODBUS_POLL_MS=1000
MODBUS_TIMEOUT_MS=2000

# Fonte OPC UA. Para testar sem servidor: npm run sim:opcua (porta 4840)
OPCUA_ENABLED=false
OPCUA_ENDPOINT=opc.tcp://localhost:4840
OPCUA_SAMPLING_MS=1000
# Certificados do cliente OPC UA (fora do git)
OPCUA_PKI_DIR=.opcua-pki
