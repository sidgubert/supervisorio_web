# Banco (TimescaleDB via Docker)
DB_HOST=localhost
# 5433 evita conflito com PostgreSQL local na 5432 (Windows)
DB_PORT=5433
DB_USER=scada
DB_PASSWORD=scada
DB_NAME=scada
# Aplica as migrations pendentes na subida da API
DB_MIGRATIONS_RUN=true

# API
PORT=3000

# Ingestão (comum a todas as fontes)
INGEST_FLUSH_MS=2000
# Teto do buffer em memoria se o banco cair (descarta as amostras mais antigas)
INGEST_BUFFER_MAX=100000

# Simulador (Fase 1)
SIM_ENABLED=true
SIM_INTERVAL_MS=1000

# Fonte MQTT (broker do docker compose)
MQTT_ENABLED=true
MQTT_URL=mqtt://localhost:1883
# Vazios = sem autenticacao
MQTT_USERNAME=
MQTT_PASSWORD=
